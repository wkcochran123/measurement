    let op :=
    { cauchy_process := pit.cauchy_process
      before := pit.cauchy_process.accumulation
      after := pit.cauchy_process.iterate? pit.cauchy_process.accumulation
    }
    {
      observation_process := op
      zero := flicker.zero
      one := register.one
      bit := op.iterate register.bit
    }


